# WebScrapeX — copy to .env.local and fill in. Never commit real values.
# Leave the Supabase values empty to run in single-user "local mode" (history in .data/).

# --- Supabase (accounts, history, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed for sign-up, API keys, schedules, admin stats and asset uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployed site (sitemap, Open Graph). e.g. https://scrape.example.com
NEXT_PUBLIC_SITE_URL=

# --- Sign-up email (6-digit code) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILJET_SENDER_EMAIL=

# --- Optional features ---
# AI extraction page (Gemini)
GOOGLE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Protects GET /api/cron/schedules (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=

# --- Rendered (JavaScript) engine ---
# Locally Chrome/Edge is auto-detected. Otherwise set one of these:
CHROME_EXECUTABLE_PATH=
BROWSER_WS_ENDPOINT=
# Serverless: URL of a @sparticuz/chromium pack (.tar) to download at runtime
CHROMIUM_PACK_URL=
# Egress proxy for the browser engine, e.g. http://user:pass@host:port
PROXY_URL=

# --- Limits & behaviour ---
RATE_LIMIT_REQUESTS_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_HOUR=100
SCRAPE_TIMEOUT_MS=20000
# SCRAPER_USER_AGENT="WebScrapeXBot/2.0 (+https://your-site/docs)"
# Development only: allow scraping localhost/private IPs
# ALLOW_PRIVATE_HOSTS=false
# Force local mode even when Supabase values are set
# WEBSCRAPEX_LOCAL_MODE=false
